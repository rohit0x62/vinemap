# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...          # recurring $10/mo Pro price

# Ed25519 private key (hex) — must match LICENSE_PUBLIC_KEY_HEX in engine/vinemap/license.py
VINEMAP_LICENSE_PRIVATE_KEY=

# Where Stripe sends customers after checkout
CHECKOUT_SUCCESS_URL=https://vinemap.xyz#pricing
CHECKOUT_CANCEL_URL=https://vinemap.xyz#pricing

# Optional: comma-separated origins for CORS (website origin)
ALLOWED_ORIGINS=https://vinemap.xyz,http://localhost:3000

# License validity after purchase (days); renewed on invoice.paid
LICENSE_DAYS=35

# Email delivery (optional — if unset, license key is logged only)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=licenses@vinemap.xyz
